{
  "rewrites": [{ "source": "/((?!.*\\.).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(favicon.svg|favicon.ico|icon-192.png|icon-512.png|apple-touch-icon.png|og-image.png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
