{
  "name": "nt-language-learning",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:app",
    "build:vocabulary": "node --no-warnings scripts/build-vocabulary-data.mjs",
    "build:brand": "node scripts/build-brand-assets.mjs",
    "test": "npm run test:source && npm run test:data && npm run build:client && npm run test:seo && npm run test:deploy && npm run test:blog && npm run test:e2e && npm run test:platform",
    "test:data": "node tests/data.mjs",
    "test:seo": "node tests/seo.mjs",
    "test:deploy": "node tests/deploy.mjs",
    "test:blog": "node tests/blog.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:platform": "node tests/platform.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "build:app": "npm run build:vocabulary && npm run build:client",
    "predev": "npm run build:vocabulary",
    "pretest:data": "npm run build:vocabulary",
    "build:client": "vite build && node scripts/prerender.mjs",
    "test:source": "node scripts/check-source.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "playwright": "^1.63.0"
  }
}
